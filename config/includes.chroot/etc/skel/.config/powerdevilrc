# LyndsOS - PowerDevil config
# Modo: nunca suspender
# Por que: para evitar que ser corte la instalacion

[AC][Display]
DimDisplayIdleTimeoutSec=-1
DimDisplayWhenIdle=false
TurnOffDisplayIdleTimeoutSec=-1
TurnOffDisplayWhenIdle=false
BrightnessIdleTimeoutSec=-1

[AC][SuspendAndShutdown]
AutoSuspendAction=0
LidAction=0
PowerButtonAction=0
TurnOffDisplay=0

[AC][Sleep]
SuspendSession=false

[Battery][Display]
DimDisplayIdleTimeoutSec=-1
DimDisplayWhenIdle=false
TurnOffDisplayIdleTimeoutSec=-1
TurnOffDisplayWhenIdle=false
BrightnessIdleTimeoutSec=-1

[Battery][SuspendAndShutdown]
AutoSuspendAction=0
LidAction=0
PowerButtonAction=0
TurnOffDisplay=0

[Battery][Sleep]
SuspendSession=false

[LowBattery][Display]
DimDisplayIdleTimeoutSec=-1
DimDisplayWhenIdle=false
TurnOffDisplayIdleTimeoutSec=-1
TurnOffDisplayWhenIdle=false
UseProfileSpecificDisplayBrightness=false

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
LidAction=0
PowerButtonAction=0

[BatteryManagement]
BatteryCriticalAction=0

[General]
pausePlayersOnSuspend=false
